{
  "name": "micardashboard",
  "version": "1.0.0",
  "description": "This project tracks issuers of Electronic Money Tokens (EMTs) under the MiCAR framework. The dashboard is a simple static site that reads data from a public Google Sheets document and visualises it using HTML and Tailwind CSS.",
  "main": "config.js",
  "scripts": {
    "test": "npm run ci:validate",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./styles/tailwind.css",
    "validate:data": "node scripts/validate-dashboard-data.js",
    "test:normalise": "node scripts/test-normalise.js",
    "test:csv": "node scripts/test-csv.js",
    "test:services": "node scripts/test-services.js",
    "build:entities": "node scripts/generate-entity-pages.js",
    "logos:harvest": "node scripts/harvest-casp-logos.js",
    "build:static": "node scripts/refresh-static-pages.js",
    "test:entities": "node scripts/test-entity-pages.js",
    "preview": "node scripts/preview.js",
    "check:css": "node scripts/check-css.js",
    "test:smoke": "node scripts/smoke.js",
    "ci:validate": "node scripts/ci-validate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "playwright": "^1.62.1",
    "tailwindcss": "^3.4.14"
  }
}
